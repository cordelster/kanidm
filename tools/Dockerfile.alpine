# Build the kanidm CLI tools using Alpine Linux.
# Supports Alpine 3.23 and edge via RUST_IMAGE and ALPINE_VERSION build args.

ARG RUST_IMAGE=rust:1-alpine3.23
ARG ALPINE_VERSION=3.23

# ======================
FROM ${RUST_IMAGE} AS builder

ARG KANIDM_FEATURES=""
ARG KANIDM_BUILD_PROFILE="container_generic"
ARG KANIDM_BUILD_OPTIONS=""

ENV KANIDM_BUILD_PROFILE=${KANIDM_BUILD_PROFILE:-container_generic}

RUN apk add --no-cache \
    clang-dev \
    cmake \
    samurai \
    eudev-dev \
    linux-pam-dev \
    openssl-dev \
    pkgconf \
    rsync \
    findutils \
    git

COPY . /usr/src/kanidm

WORKDIR /usr/src/kanidm

RUN --mount=type=cache,id=cargo-alpine-tools-registry,target=/usr/local/cargo/registry \
    export CARGO_HOME=/usr/local/cargo && \
    export CC="/usr/bin/clang" && \
    cargo build --locked -p kanidm_tools ${KANIDM_BUILD_OPTIONS} \
        --target-dir="/usr/src/kanidm/target/" \
        --features="${KANIDM_FEATURES}" \
        --release && \
    cargo build --locked -p kanidm-ipa-sync ${KANIDM_BUILD_OPTIONS} \
        --target-dir="/usr/src/kanidm/target/" \
        --features="${KANIDM_FEATURES}" \
        --release && \
    cargo build --locked -p kanidm-ldap-sync ${KANIDM_BUILD_OPTIONS} \
        --target-dir="/usr/src/kanidm/target/" \
        --features="${KANIDM_FEATURES}" \
        --release && \
    cargo install \
        --git https://github.com/kanidm/webauthn-rs.git \
        --rev 66a3d9903b31fa5a67fc00dd65ba8f55695df183 \
        --force fido-mds-tool \
        --target-dir="/usr/src/kanidm/target/"

# ======================
FROM alpine:${ALPINE_VERSION}

RUN apk add --no-cache \
    ca-certificates \
    openssl \
    tzdata

COPY --from=builder --chmod=0755 /usr/src/kanidm/target/release/kanidm /sbin/
COPY --from=builder --chmod=0755 /usr/src/kanidm/target/release/kanidm-ipa-sync /sbin/
COPY --from=builder --chmod=0755 /usr/src/kanidm/target/release/kanidm-ldap-sync /sbin/
COPY --from=builder --chmod=0755 /usr/src/kanidm/target/release/fido-mds-tool /sbin/

RUN mkdir /etc/kanidm && touch /etc/kanidm/config

ENV RUST_BACKTRACE=1

CMD [ "/sbin/kanidm", "-h" ]
